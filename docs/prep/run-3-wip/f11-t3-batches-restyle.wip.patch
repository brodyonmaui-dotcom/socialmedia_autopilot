+          primary={primary}
+          danger={danger}
+        />
+      </div>
       ) : null}
     </li>
   );
diff --git a/apps/web/app/batches/ui/ResetSheet.tsx b/apps/web/app/batches/ui/ResetSheet.tsx
new file mode 100644
index 0000000..58ed243
--- /dev/null
+++ b/apps/web/app/batches/ui/ResetSheet.tsx
@@ -0,0 +1,200 @@
+"use client";
+
+import { useEffect, useId, useState } from "react";
+import { useFormStatus } from "react-dom";
+import type { Platform } from "@autopilot/core";
+import { Button, Checkbox, Icon, Input, PLATFORM_NAME, PlatformLogo, Readout, Sheet, cx } from "../../../components/ui/index.js";
+import { autoCheckText, canConfirmReset, keyTailLabel, type AutoCheckState } from "../../../lib/batches/card-view.js";
+import { isResettablePlatform, RESET_CHECKLIST } from "../../../lib/batches/reset.js";
+import type { ItemStatus } from "../../../lib/batches/types.js";
+import { igCheckAction, recordPublishedAction, resetCheckedAction } from "../[id]/actions.js";
+
+type Mode = "reset" | "record";
+
+export interface ResetSheetProps {
+  batchId: string;
+  itemId: string;
+  platform: Platform;
+  status: ItemStatus;
+  attempts: number;
+  /** Sanitised at write time (F7 B1), straight from batch_items.last_error. Nothing else is shown. */
+  lastError: string | null;
+  /** "Mon 16 Nov · 09:00" in the creator's zone. */
+  scheduled: string;
+  keyTail: string | null;
+  /** "Not on the platform → back to draft" applies (failed|unknown, no platform post id, outbox platform). */
+  canReset: boolean;
+  /** Open on load (deep link `?reset=<itemId>`). */
+  defaultOpen?: Mode | undefined;
+}
+
+function Submit({ label, disabled, form }: { label: string; disabled: boolean; form: string }) {
+  const { pending } = useFormStatus();
+  return (
+    <Button type="submit" form={form} variant="solid" disabled={disabled || pending} aria-disabled={disabled || pending} className="sm:min-w-40">
+      {pending ? "Working…" : label}
+    </Button>
+  );
+}
+
+/** A two-line-safe label inside a Button (Button itself is nowrap). */
+const Wrap = ({ children }: { children: string }) => <span className="whitespace-normal text-left">{children}</span>;
+
+/**
+ * F11: the two buttons on a failed/unknown card and the sheet behind them. IG runs the read-only
+ * automatic check (igCheckAction) each time the sheet opens; a hit hides the reset and prefills
+ * "record it". "Confirm reset" stays disabled until every checklist box is ticked. The server
+ * re-checks everything (the checklist strings and the IG lookup); nothing here is trusted.
+ */
+export function ResetSheet(p: ResetSheetProps) {
+  const [mode, setMode] = useState<Mode>(p.defaultOpen ?? (p.canReset ? "reset" : "record"));
+  const [open, setOpen] = useState(p.defaultOpen != null);
+  const [check, setCheck] = useState<AutoCheckState>(p.platform === "instagram" ? "checking" : "n/a");
+  const [ticked, setTicked] = useState<Set<string>>(new Set());
+  const [url, setUrl] = useState("");
+  const [postId, setPostId] = useState("");
+  const formId = useId();
+  const isIg = p.platform === "instagram";
+  const list = isResettablePlatform(p.platform) ? RESET_CHECKLIST[p.platform] : [];
+
+  useEffect(() => {
+    if (!open || !isIg) return;
+    let live = true;
+    setCheck("checking");
+    igCheckAction(p.batchId, p.itemId)
+      .then((r) => {
+        if (!live) return;
+        setCheck(r.result);
+        if (r.result === "found") {
+          setMode("record");
+          if (r.url) setUrl(r.url);
+          if (r.platformPostId) setPostId(r.platformPostId);
+        }
+      })
+      .catch(() => live && setCheck("error"));
+    return () => {
+      live = false;
+    };
+  }, [open, isIg, p.batchId, p.itemId]);
+
+  const show = (m: Mode) => {
+    setMode(m);
+    setOpen(true);
+  };
+  const close = () => setOpen(false);
+  const resetAllowed = p.canReset && check !== "found";
+  const showReset = mode === "reset" && resetAllowed;
+  const ready = canConfirmReset({ list, ticked, check, isInstagram: isIg });
+  const auto = autoCheckText(check);
+  const name = PLATFORM_NAME[p.platform];
+
+  const toggle = (s: string, on: boolean) =>
+    setTicked((prev) => {
+      const next = new Set(prev);
+      if (on) next.add(s);
+      else next.delete(s);
+      return next;
+    });
+
+  return (
+    <>
+      <div className="flex flex-col gap-2">
+        {p.canReset ? (
+          <Button variant="outline" block onClick={() => show("reset")}>
+            <Wrap>Not on the platform → back to draft</Wrap>
+          </Button>
+        ) : null}
+        <Button variant="outline" block onClick={() => show("record")}>
+          <Wrap>It&apos;s there → record it</Wrap>
+        </Button>
+      </div>
+
+      <Sheet
+        open={open}
+        onClose={close}
+        title={showReset ? "Back to draft?" : "Record as published"}
+        footer={
+          <>
+            <Button variant="outline" onClick={close}>
+              Cancel
+            </Button>
+            {showReset ? <Submit form={formId} label="Confirm reset" disabled={!ready} /> : <Submit form={formId} label="Record it" disabled={url.trim() === ""} />}
+          </>
+        }
+      >
+        <div className="flex flex-col gap-5">
+          <div className="flex items-center gap-3 border-b border-ds-line pb-4 text-ds-text">
+            <PlatformLogo platform={p.platform} size={22} />
+            <span className="ds-caps">{name}</span>
+            <span className="ds-mono ml-auto text-ds-faint">{keyTailLabel(p.keyTail)}</span>
+          </div>
+          <Readout
+            items={[
+              { k: "Status", v: p.status },
+              { k: "Attempts", v: String(p.attempts) },
+              { k: "Scheduled", v: p.scheduled },
+            ]}
+          />
+          <div>
+            <p className="ds-caps text-ds-faint">Last error</p>
+            <p className="ds-mono mt-1 border-l-2 border-ds-danger pl-3 text-ds-text [overflow-wrap:anywhere]">{p.lastError || "none recorded"}</p>
+          </div>
+
+          {isIg ? (
+            <p
+              role="status"
+              className={cx(
+                "flex items-start gap-2 border bg-ds-card px-3 py-2 text-[13px] leading-snug",
+                auto.tone === "warn" ? "border-ds-warn/60 text-ds-warn" : auto.tone === "accent" ? "border-ds-accent text-ds-accent-fg" : "border-ds-line text-ds-muted",
+              )}
+            >
+              <Icon name={auto.tone === "warn" ? "alert" : auto.tone === "accent" ? "check" : "clock"} size={14} className="mt-px shrink-0" />
+              {auto.text}
+            </p>
+          ) : null}
+
+          {showReset ? (
+            <form id={formId} action={resetCheckedAction} className="flex flex-col gap-2">
+              <input type="hidden" name="batchId" value={p.batchId} />
+              <input type="hidden" name="itemId" value={p.itemId} />
+              <fieldset>
+                <legend className="ds-caps mb-1 text-ds-text">I checked · tick every box</legend>
+                {list.map((s) => (
+                  <Checkbox key={s} name="checked" value={s} label={s} checked={ticked.has(s)} onChange={(e) => toggle(s, e.currentTarget.checked)} />
+                ))}
+              </fieldset>
+              <p className="ds-mono text-ds-faint">
+                {ticked.size}/{list.length} ticked · the reset never approves: it comes back as a draft
+              </p>
+              <Button variant="ghost" onClick={() => setMode("record")} className="self-start">
+                <Wrap>It&apos;s there → record it instead</Wrap>
+              </Button>
+            </form>
+          ) : (
+            <form id={formId} action={recordPublishedAction} className="flex flex-col gap-4">
+              <input type="hidden" name="batchId" value={p.batchId} />
+              <input type="hidden" name="itemId" value={p.itemId} />
+              <Input
+                label={`${name} post link`}
+                name="url"
+                type="url"
+                inputMode="url"
+                required
+                placeholder="https://"
+                value={url}
+                onChange={(e) => setUrl(e.currentTarget.value)}
+                helper={`https only, on ${name}'s own domain`}
+              />
+              <Input label="Post id (optional)" name="platformPostId" value={postId} onChange={(e) => setPostId(e.currentTarget.value)} autoComplete="off" />
+              {resetAllowed ? (
+                <Button variant="ghost" onClick={() => setMode("reset")} className="self-start">
+                  <Wrap>Not there → back to draft instead</Wrap>
+                </Button>
+              ) : null}
+            </form>
+          )}
+        </div>
+      </Sheet>
+    </>
+  );
+}
