# Copy to .env (never commit). On the VPS: /opt/autopilot/.env, chmod 600.
# Probes and the app read these. Leave unset what you don't have yet.

# --- General ---
# IANA zone, e.g. America/New_York. Real value lives only in .env (location boundary: public repo)
TZ_CREATOR=
# global safety switch; real posting needs DRY_RUN=false AND per-command --live
DRY_RUN=true
# R2 custom domain
PUBLIC_MEDIA_BASE=https://media.example.com

# --- Meta (Facebook Login for Business) ---
META_APP_ID=
META_APP_SECRET=
# Page access token for the Page linked to IG (written by probe:connect-meta; no fixed expiry). Never log.
META_ACCESS_TOKEN=
# long-lived user token (written by probe:connect-meta; used for debug_token/scopes)
META_USER_TOKEN=
# e.g. v25.0; empty = app default version
META_GRAPH_VERSION=v25.0
# IG professional account id (probe prints it)
IG_USER_ID=

# --- Google / YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Zernio (TikTok) ---
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Anthropic (comment/DM triage only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=autopilot-media
R2_BUCKET_BACKUPS=autopilot-backups

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://autopilot:${POSTGRES_PASSWORD}@db:5432/autopilot
DOMAIN=autopilot.example.com
