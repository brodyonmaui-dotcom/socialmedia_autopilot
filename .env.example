# Copy to .env (never commit). On the VPS: /opt/autopilot/.env, chmod 600.
# Probes and the app read these. Leave unset what you don't have yet.

# --- General ---
TZ_CREATOR=                         # IANA zone, e.g. America/New_York. Real value lives only in .env (location boundary: public repo)
DRY_RUN=true                        # global safety switch; real posting needs DRY_RUN=false AND per-command --live
PUBLIC_MEDIA_BASE=https://media.example.com   # R2 custom domain

# --- Meta (Facebook Login for Business) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=                  # long-lived user or system-user token; never log
META_GRAPH_VERSION=                 # e.g. v25.0; empty = app default version
IG_USER_ID=                         # IG professional account id (probe prints it)

# --- Google / YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Zernio (TikTok) ---
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Anthropic (comment/DM triage only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=autopilot-media
R2_BUCKET_BACKUPS=autopilot-backups

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://autopilot:${POSTGRES_PASSWORD}@db:5432/autopilot
DOMAIN=autopilot.example.com
