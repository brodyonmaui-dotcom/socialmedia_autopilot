# Copy to .env (never commit). On the VPS: /opt/autopilot/.env, chmod 600.
# Probes and the app read these. Leave unset what you don't have yet.

# --- General ---
# IANA zone, e.g. America/New_York. Real value lives only in .env (location boundary: public repo)
TZ_CREATOR=
# global safety switch; real posting needs DRY_RUN=false AND per-command --live
DRY_RUN=true
# worker live key: set to 1 (with DRY_RUN=false) to let the worker act for real; the argv flag does the same
WORKER_LIVE=
# R2 custom domain
PUBLIC_MEDIA_BASE=https://media.example.com

# --- Meta (Facebook Login for Business) ---
META_APP_ID=
META_APP_SECRET=
# Page access token for the Page linked to IG (written by probe:connect-meta; no fixed expiry). Never log.
META_ACCESS_TOKEN=
# long-lived user token (written by probe:connect-meta; used for debug_token/scopes)
META_USER_TOKEN=
# e.g. v25.0; empty = app default version
META_GRAPH_VERSION=v25.0
# IG professional account id (probe prints it)
IG_USER_ID=

# --- Google / YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Our YouTube channel id (UC...); marks our own comments in the engagement poll
YT_CHANNEL_ID=
# 1 = enable YouTube comment replies (needs the youtube.force-ssl scope); empty = off
YT_COMMENT_REPLIES=

# --- Zernio (TikTok) ---
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Anthropic (comment/DM triage only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=autopilot-media
R2_BUCKET_BACKUPS=autopilot-backups

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=
# Write the actual password literally here, not ${POSTGRES_PASSWORD} — plain .env
# loaders (docker --env-file, node's loadEnvFile) don't expand nested variables,
# only docker-compose.yml's own `environment:` block does.
DATABASE_URL=postgresql://autopilot:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/autopilot
DOMAIN=autopilot.example.com
# Dev only: the origin the browser uses for passkey login when DOMAIN is unset (default http://localhost:3100).
# In production DOMAIN is the passkey rpID and https://DOMAIN the only accepted origin.
WEB_ORIGIN=
# Dashboard basic auth in front of /app* (Caddy). Create the hash with `caddy hash-password`
# (docs/runbooks/dashboard-password.md). Single-quote the hash: it contains $ signs.
DASH_USER=
DASH_HASH=''
# Caption lint (location boundary, non-negotiable 5): comma-separated words/places that approval
# must reject in captions. Real values go in .env only (the repo is public); leave empty here.
PRIVACY_BLOCKLIST=

# --- Ingest agent (laptop-only .env, never deployed to the VPS) ---
# Postgres isn't publicly reachable — tunnel it first: ssh -L 5433:127.0.0.1:5432 autopilot
# then point DATABASE_URL at postgresql://autopilot:<password>@localhost:5433/autopilot in THIS
# laptop's .env (a different DATABASE_URL value than the VPS's own .env, which uses host "db").
# Explicit allowlisted folders only, "pillar=path" pairs separated by ";" — never the raw camera
# roll / iCloud Photos sync, and never a recursive crawl of an editor's project folder (cache dirs).
INGEST_ROOTS=
