{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin
	}
	# Static pages (privacy policy for Meta/Google branding, Snapchat share test) stay static;
	# /app is the dashboard (Next.js, basePath /app: pages AND assets live under it). Until the M2
	# passkey login lands, HTTP basic auth gates all of /app*. DASH_USER / DASH_HASH come from .env
	# (hash from `caddy hash-password`, see docs/runbooks/dashboard-password.md). If either is unset,
	# Caddy still loads and /app* rejects every login (fails closed; checked with caddy 2.10 locally).
	handle /app* {
		basic_auth {
			{$DASH_USER} {$DASH_HASH}
		}
		reverse_proxy web:3000
	}
	handle /privacy* {
		root * /srv/static
		rewrite * /privacy.html
		file_server
	}
	handle /snap-test* {
		root * /srv/static
		rewrite * /snap-test.html
		file_server
	}
	handle /terms* {
		root * /srv/static
		rewrite * /terms.html
		file_server
	}
	handle / {
		root * /srv/static
		rewrite * /index.html
		file_server
	}
	# Shared CSS + self-hosted OFL fonts for the static pages above (no third-party requests).
	handle /assets/* {
		root * /srv/static
		header Cache-Control "public, max-age=604800"
		file_server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond "autopilot: not public" 404
	}
}
