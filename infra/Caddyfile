{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin
	}
	# Static pages (privacy policy for Meta/Google branding, Snapchat share test) stay static;
	# /app is the dashboard (Next.js), not yet behind login — don't link it publicly before M2 auth lands.
	handle /app* {
		reverse_proxy web:3000
	}
	handle /privacy* {
		root * /srv/static
		rewrite * /privacy.html
		file_server
	}
	handle /snap-test* {
		root * /srv/static
		rewrite * /snap-test.html
		file_server
	}
	handle /terms* {
		root * /srv/static
		rewrite * /terms.html
		file_server
	}
	handle / {
		root * /srv/static
		rewrite * /index.html
		file_server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond "autopilot: not public" 404
	}
}
